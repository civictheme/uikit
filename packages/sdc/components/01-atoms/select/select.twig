{#
/**
 * @file
 * CivicTheme Select component.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - id: [string] DOM ID attribute.
 * - name: [string] DOM name (or provide it via attributes).
 * - is_multiple: [boolean] Whether to allow multiple selections.
 * - options: [array] Options, matching Drupal core's prepared select options structure (keys mirror the HTML option attributes):
 *   Each item contains:
 *   - type: [string] Option type (option group or option).
 *   - label: [string] Option label.
 *   - value: [string,array] Option value.
 *   - selected: [boolean] Whether the option is selected.
 *   - disabled: [boolean] Whether the option is disabled.
 *   - options: [array] Options (applies to optgroup type):
 *     Each item contains:
 *     - label: [string] Option label.
 *     - value: [string] Option value.
 *     - selected: [boolean] Whether the option is selected.
 *     - disabled: [boolean] Whether the option is disabled.
 * - is_invalid: [boolean] Whether the select is invalid. With the id prop set, the control references the field error message via aria-describedby="{id}--error-message".
 * - is_disabled: [boolean] Whether the select is disabled.
 * - is_required: [boolean] Whether the select is required.
 * - modifier_class: [string] Additional CSS classes.
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 */
#}

{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set is_invalid_class = is_invalid ? 'ct-select--is-invalid' : '' %}
{% set modifier_class = '%s %s %s'|format(theme_class, is_invalid_class, modifier_class|default(''))|trim %}

<select
  class="ct-select {{ modifier_class -}}"
  {% if name is not empty %}name="{{ name }}"{% endif %}
  {% if id %}id="{{ id }}"{% endif %}
  {% if is_multiple %}multiple{% endif %}
  {% if is_disabled %}disabled{% endif %}
  {% if is_required %}required{% endif %}
  {% if is_invalid %}aria-invalid="true"{% endif %}
  {% if is_invalid and id is not empty %}aria-describedby="{{ id }}--error-message"{% endif %}
  {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}
>
  {% for option in options|default([]) %}
    {% if option.type == 'optgroup' %}
      <optgroup label="{{ option.label }}" {% if option.disabled %}disabled{% endif %}>
        {% for sub_option in option.options %}
          {% if sub_option.label is not empty %}
            <option value="{{ sub_option.value|default('') }}" {% if sub_option.selected %}selected="selected"{% endif %} {% if sub_option.disabled %}disabled{% endif %}>{{ sub_option.label }}</option>
          {% endif %}
        {% endfor %}
      </optgroup>
    {% elseif option.type == 'option' %}
      {% if option.label is not empty %}
        <option value="{{ option.value|default('') }}" {% if option.selected %}selected="selected"{% endif %} {% if option.disabled %}disabled{% endif %}>{{ option.label }}</option>
      {% endif %}
    {% endif %}
  {% endfor %}
</select>
