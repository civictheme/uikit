{#
/**
 * @file
 * CivicTheme Select component.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - id: [string,null] DOM ID attribute.
 * - name: [string,null] DOM name (or provide it via attributes).
 * - is_multiple: [boolean,null] Whether to allow multiple selections.
 * - options: [array,null] Options, matching Drupal core's prepared select options structure (keys mirror the HTML option attributes):
 *   Each item contains:
 *   - type: [string] Option type (option group or option).
 *   - label: [string,number] Option label.
 *   - value: [string,number,array] Option value.
 *   - selected: [boolean] Whether the option is selected.
 *   - disabled: [boolean] Whether the option is disabled.
 *   - options: [array] Options (applies to optgroup type):
 *     Each item contains:
 *     - label: [string,number] Option label.
 *     - value: [string,number] Option value.
 *     - selected: [boolean] Whether the option is selected.
 *     - disabled: [boolean] Whether the option is disabled.
 * - is_invalid: [boolean,null] Whether the select is invalid. With the id prop set, the control references the field error message via aria-describedby="{id}--error-message".
 * - is_disabled: [boolean,null] Whether the select is disabled.
 * - is_required: [boolean,null] Whether the select is required.
 * - modifier_class: [string,null] Additional CSS classes.
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 */
#}

{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set is_invalid_class = is_invalid ? 'ct-select--is-invalid' : '' %}
{% set modifier_class = '%s %s %s'|format(theme_class, is_invalid_class, modifier_class|default(''))|trim %}

{# Props fold into attributes when present, so the control renders entirely
   from the attributes object and platform-prepared attributes pass through
   without duplication. #}
{% set attributes = attributes is defined and attributes is not null ? attributes : create_attribute({}) %}
{% do attributes.addClass('ct-select', modifier_class) %}
{% if name is not empty %}{% do attributes.setAttribute('name', name) %}{% endif %}
{% if id %}{% do attributes.setAttribute('id', id) %}{% endif %}
{% if is_multiple %}{% do attributes.setAttribute('multiple', true) %}{% endif %}
{% if is_disabled %}{% do attributes.setAttribute('disabled', true) %}{% endif %}
{% if is_required %}{% do attributes.setAttribute('required', true) %}{% endif %}
{% if is_invalid %}{% do attributes.setAttribute('aria-invalid', 'true') %}{% endif %}
{% if is_invalid and id is not empty %}{% do attributes.setAttribute('aria-describedby', id ~ '--error-message') %}{% endif %}

<select{{ attributes }}>
  {% for option in options|default([]) %}
    {% if option.type == 'optgroup' %}
      <optgroup label="{{ option.label }}" {% if option.disabled %}disabled{% endif %}>
        {% for sub_option in option.options %}
          {% if sub_option.label is not empty %}
            <option value="{{ sub_option.value|default('') }}" {% if sub_option.selected %}selected="selected"{% endif %} {% if sub_option.disabled %}disabled{% endif %}>{{ sub_option.label }}</option>
          {% endif %}
        {% endfor %}
      </optgroup>
    {% elseif option.type == 'option' %}
      {% if option.label is not empty %}
        <option value="{{ option.value|default('') }}" {% if option.selected %}selected="selected"{% endif %} {% if option.disabled %}disabled{% endif %}>{{ option.label }}</option>
      {% endif %}
    {% endif %}
  {% endfor %}
</select>
