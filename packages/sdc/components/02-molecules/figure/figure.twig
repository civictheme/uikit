{#
/**
 * @file
 * CivicTheme Figure component.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - modifier_class: [string] Additional CSS classes.
 * - url: [string] Image URL.
 * - alt: [string] Image alt text.
 * - width: [integer,null] Image width.
 * - height: [integer,null] Image height.
 * - alignment: [string] Figure alignment (left, center, right, none).
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 *
 * Slots:
 * - caption: Image caption.
 */
#}

{% set alignment_class = alignment in ['left', 'center', 'right'] ? 'align-%s ct-figure--align-%s'|format(alignment, alignment) : '' %}
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s %s'|format(theme_class, alignment_class, modifier_class|default('')) %}

{% if url is not empty %}
  <figure class="ct-figure {{ modifier_class -}}" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    {% include 'civictheme:image' with {
      theme: theme,
      url: url,
      alt: alt,
      width: width,
      height: height,
      modifier_class: 'ct-figure__image',
    } only %}

    {% if caption is not empty %}
      <figcaption class="ct-figure__caption">
        {% include 'civictheme:icon' with {
          symbol: 'image',
        } only %}
        {{ caption }}
      </figcaption>
    {% endif %}
  </figure>
{% endif %}
