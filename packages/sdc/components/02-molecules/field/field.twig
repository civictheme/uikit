{#
/**
 * @file
 * CivicTheme Field component.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - type: [string] Control type, used for presentation only (type class; hidden suppresses title, description and message).
 * - is_group: [boolean] Whether the field wraps a group of options - the root element becomes a <fieldset> and the title renders as its <legend> (title_position is ignored).
 * - title: [string] Field title.
 * - title_position: [string] Where the title renders. "before" places it above the control; "after" places it as a label following the control with the description below. Ignored for groups. Defaults to "after" when title_display is "after" and for a single (non-group) checkbox or radio.
 * - title_display: [string] How to display the field title. Canonical values are visible, invisible and hidden. The Drupal form vocabulary is accepted and normalised ("before", "after" and "inline" mean visible and carry the title position and orientation, "visually_hidden" means invisible, "none" and "attribute" mean hidden).
 * - title_size: [string] The size of the title (extra-small, small, regular, large, extra-large).
 * - description: [string] Field description. Rendered with id "{id}--description" when the id prop is set, for controls to reference via aria-describedby.
 * - id: [string] The control DOM ID, used for the title label's "for" attribute and the description and error message ids.
 * - is_invalid: [boolean] Whether the field is invalid.
 * - is_disabled: [boolean] Whether the field is disabled.
 * - is_required: [boolean] Whether the field is required.
 * - required_text: [string] Text to display within the label element when required.
 * - orientation: [string] Elements orientation (vertical or horizontal). Defaults to horizontal when title_display is "inline".
 * - message: [object,null] Message object for showing messages, or null for none. When no attributes are provided and the id prop is set, the message renders with id "{id}--error-message", for controls to reference via aria-describedby.
 *   Each property contains:
 *   - content: [string] Message content.
 * - prefix: [string] Content to add before the control.
 * - suffix: [string] Content to add after the control.
 * - modifier_class: [string] Additional CSS classes.
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 *
 * Slots:
 * - children: Pre-rendered control markup (form controls built from the atoms, or markup rendered by the consuming platform). Printed as a direct child of the field root.
 */
#}

{% set type = type is defined and type is not empty ? type : 'hidden' %}
{% set is_group = is_group is defined ? is_group : false %}
{# Normalise the Drupal title_display vocabulary onto the canonical enum.
   'before', 'after' and 'inline' are visible titles that carry the title
   position and orientation, 'visually_hidden' is the webform spelling of
   'invisible', and 'none' and 'attribute' render no title. #}
{% set title_display = title_display is defined and title_display is not empty ? title_display : 'visible' %}
{# A single checkbox or radio renders its label beside the control by
   default, whatever the title_display value. #}
{% set title_position = title_position is defined and title_position in ['before', 'after'] ? title_position : (title_display == 'after' or (type in ['checkbox', 'radio'] and not is_group) ? 'after' : 'before') %}
{% set orientation = orientation is defined and orientation in ['vertical', 'horizontal'] ? orientation : (title_display == 'inline' ? 'horizontal' : 'vertical') %}
{% set title_display = title_display in ['before', 'after', 'inline'] ? 'visible' : title_display %}
{% set title_display = title_display in ['none', 'attribute'] ? 'hidden' : title_display %}
{% set title_display = title_display == 'visually_hidden' ? 'invisible' : title_display %}
{% set title_display = title_display in ['visible', 'invisible', 'hidden'] ? title_display : 'visible' %}
{# A group keeps its accessible name and a single checkbox or radio keeps an
   accessible label: a hidden title degrades to a visually hidden one. #}
{% set title_display = (is_group or type in ['checkbox', 'radio']) and title_display == 'hidden' and title is not empty ? 'invisible' : title_display %}
{% set title_size = (title_size is defined and title_size in ['extra-small', 'small', 'regular', 'large', 'extra-large']) ? title_size : '' %}
{% set is_invalid = is_invalid is defined ? is_invalid : false %}
{% set is_disabled = is_disabled is defined ? is_disabled : false %}
{% set is_required = is_required is defined ? is_required : false %}
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set type_class = 'ct-field--%s'|format(type) %}
{% set is_group_class = is_group ? 'ct-field--group' : '' %}
{% set is_required_class = is_required ? 'ct-field--required' : '' %}
{% set is_disabled_class = is_disabled ? 'ct-field--disabled' : '' %}
{% set is_invalid_class = is_invalid ? 'ct-field--invalid' : '' %}
{% set orientation_class = 'ct-field--%s'|format(orientation) %}
{% set modifier_class = '%s %s %s %s %s %s %s %s'|format(theme_class, type_class, orientation_class, is_group_class, is_required_class, is_disabled_class, is_invalid_class, modifier_class|default('')) %}
{% set description_id = description is defined and description is not empty and type != 'hidden' and id is defined and id is not empty ? '%s--description'|format(id) : null %}
{% set message_id = (message or is_invalid) and type != 'hidden' and id is defined and id is not empty ? '%s--error-message'|format(id) : null %}
{% set show_title = title is not empty and title_display != 'hidden' and type != 'hidden' %}
{% set root_tag = is_group ? 'fieldset' : 'div' %}

<{{ root_tag }} class="ct-field {{ modifier_class -}}" {% if attributes %}{{- attributes -}}{% endif %}>
  {% if show_title and (is_group or title_position == 'before') %}
    {% include 'civictheme:label' with {
      theme: theme,
      tag: is_group ? 'legend' : 'label',
      content: title,
      size: title_size is not empty ? title_size : 'regular',
      is_required: is_required,
      required_text: required_text,
      for: not is_group and id is defined and id is not empty ? id : null,
      modifier_class: 'ct-field__title' ~ (title_display == 'invisible' ? ' ct-visually-hidden' : ''),
    } only %}
  {% endif %}

  {% if description is not empty and type != 'hidden' and (is_group or title_position == 'before') %}
    {% include 'civictheme:field-description' with {
      theme: theme,
      content: description,
      modifier_class: 'ct-field__description',
      attributes: description_id ? create_attribute({id: description_id}) : null,
    } only %}
  {% endif %}

  {% if prefix is not empty %}
    <div class="ct-field__prefix">{{- prefix -}}</div>
  {% endif %}

  {{- children -}}
  {%- if show_title and not is_group and title_position == 'after' %}
    {% include 'civictheme:label' with {
      theme: theme,
      content: title,
      size: title_size is not empty ? title_size : 'regular',
      is_required: is_required,
      required_text: required_text,
      for: id is defined and id is not empty ? id : null,
      modifier_class: 'ct-field__label' ~ (title_display == 'invisible' ? ' ct-visually-hidden' : ''),
    } only %}
  {% endif -%}

  {% if description is not empty and type != 'hidden' and not is_group and title_position == 'after' %}
    {% include 'civictheme:field-description' with {
      theme: theme,
      content: description,
      modifier_class: 'ct-field__description',
      attributes: description_id ? create_attribute({id: description_id}) : null,
    } only %}
  {% endif %}

  {% if suffix is not empty %}
    <div class="ct-field__suffix">{{- suffix -}}</div>
  {% endif %}

  {% if (message or is_invalid) and type != 'hidden' %}
    {% set error_message = 'Field has an error' %}
    {% if title is not empty %}
      {% set error_message = 'Field <em>' ~ title ~ '</em> has an error' %}
    {% endif %}

    {% set message_content = null %}
    {% if is_invalid %}
      {% set message_content = error_message %}
    {% endif %}

    {% if message is defined and message.content is defined %}
      {% set message_content = message.content %}
    {% endif %}

    {% include 'civictheme:field-message' with {
      theme: theme,
      type: is_invalid ? 'error' : 'information',
      content: message_content,
      modifier_class: 'ct-field__message',
      attributes: message.attributes|default(message_id ? create_attribute({id: message_id}) : create_attribute({})),
    } only %}
  {% endif %}
</{{ root_tag }}>
