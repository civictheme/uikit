{
  "name": "@civictheme/tokens",
  "version": "2.0.0-alpha.0",
  "license": "GPL-2.0-or-later",
  "description": "CivicTheme design tokens: DTCG source of truth for colour, built to UIKit CSS custom properties and Figma variable import files.",
  "homepage": "https://github.com/civictheme/uikit",
  "bugs": "https://github.com/civictheme/uikit",
  "repository": "https://github.com/civictheme/uikit.git",
  "type": "module",
  "private": true,
  "exports": {
    "./build/lib.mjs": "./build/lib.mjs",
    "./build/emit.mjs": "./build/emit.mjs",
    "./build/figma-names.mjs": "./build/figma-names.mjs",
    "./build/figma-ingest.mjs": "./build/figma-ingest.mjs",
    "./tokens/*.json": "./tokens/*.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "dist": "node build/build.mjs",
    "build-storybook": "echo @civictheme/tokens has no Storybook",
    "ingest": "node build/figma-ingest.mjs",
    "test": "node tests/validate-resolved-values.mjs && node tests/validate-figma-ingest.mjs && node tests/validate-figma-emit.mjs",
    "test:ci": "npm run test",
    "lint": "eslint ./build ./tests",
    "lint:fix": "eslint ./build ./tests --fix"
  }
}
